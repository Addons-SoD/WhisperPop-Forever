<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">

	<Button name="WhisperPopOutButton" frameStrata="DIALOG" parent="UIParent">
		<Size>
			<AbsDimension x="32" y="32"/>
		</Size>
		<Anchors>
			<!-- WoW Forever: ChatFrameChannelButton may be absent. Anchor to the
			     screen bottom first, then WP_UpdateButtonSide repositions it. -->
			<Anchor point="BOTTOM" relativeTo="UIParent">
				<Offset><AbsDimension x="0" y="100"/></Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="$parentFlashTextuter" file="Interface\Buttons\UI-Common-MouseHilight" setAllPoints="true" hidden="true" alphaMode="ADD"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				self.flash = WhisperPopOutButtonFlashTextuter;
				if WP_UpdateButtonSide then
					WP_UpdateButtonSide(DEFAULT_CHAT_FRAME);
				end
			</OnLoad>
			<OnClick>
				-- WoW Forever: SOUNDKIT entry may be absent; the main frame may not exist yet.
				if SOUNDKIT and SOUNDKIT.IG_CHAT_EMOTE_BUTTON then
					PlaySound(SOUNDKIT.IG_CHAT_EMOTE_BUTTON);
				end
				if WhisperPopFrame then
					if (WhisperPopFrame:IsShown()) then
						WhisperPopFrame:Hide();
					else
						WhisperPopFrame:Show();
					end
				end
			</OnClick>
			<OnEnter>
				GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
				GameTooltip:SetText(WHISPER_POP_LABEL, 1, 1, 1);
				GameTooltip:AddLine(WHISPER_POP_DESC, 1, 0.85, 0);
				GameTooltip:Show();
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
			<OnUpdate>
				if WhisperPopOutButton_OnUpdate then
					WhisperPopOutButton_OnUpdate(self, elapsed);
				end
			</OnUpdate>
		</Scripts>
		<NormalTexture file="Interface\AddOns\WhisperPop\Texture\normal-up"/>
		<PushedTexture file="Interface\AddOns\WhisperPop\Texture\normal-down"/>
		<DisabledTexture file="Interface\AddOns\WhisperPop\Texture\normal-disabled"/>
		<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
	</Button>

</Ui>
